# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-nebius-key-here
NEBIUS_API=https://api.studio.nebius.com/v1/
# Model names as listed in Nebius AI Studio (check they are available for your account)

GENERATOR_LLM=deepseek-ai/DeepSeek-V4-Flash-0731
CLASSIFIER_LLM=nvidia/Nemotron-3_5-Lightning
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-8B

DATA_DIR=data
VECTOR_STORE_DIR=data/chroma
LLM_TIMEOUT=120
RETRIEVAL_K=10
RETRIEVAL_MIN_SCORE=0.15
# BM25 index text: full (default) or short (title + brand only)
BM25_FIELDS=short
# Optional: Comet Opik (tracing, prompts, experiments). Leave empty to disable.
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=rag-ecommerce
