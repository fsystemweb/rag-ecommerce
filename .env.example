# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-nebius-key-here
NEBIUS_API=https://api.studio.nebius.com/v1/
# Model names as listed in Nebius AI Studio (check they are available for your account)
GENERATOR_LLM=meta-llama/Llama-3.3-70B-Instruct
CLASSIFIER_LLM=meta-llama/Meta-Llama-3.1-8B-Instruct
EMBEDDINGS_MODEL=BAAI/bge-multilingual-gemma2
EMBEDDINGS_PRICE_PER_1M=0.01
DATA_DIR=data
VECTOR_STORE_DIR=data/chroma
RETRIEVAL_K=10
RETRIEVAL_MIN_SCORE=0.2
# Optional: Comet Opik (tracing, prompts, experiments). Leave empty to disable.
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=rag-ecommerce
